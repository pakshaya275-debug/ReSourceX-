# ---- Required in production ----------------------------------------------
# PostgreSQL connection string (Neon, Render Postgres, or local)
DATABASE_URL=postgresql://username:password@localhost:5432/resourcex
# Long random secret, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Comma-separated origins allowed to call the API, e.g. https://resourcex-frontend.onrender.com
CORS_ORIGIN=http://localhost:5500

# ---- Optional -------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Set to false for a local database without SSL. Defaults to SSL in production.
DATABASE_SSL=
# Maximum database connections per instance
PG_POOL_MAX=10
# Trust the X-Forwarded-For header from a reverse proxy (automatic in production)
TRUST_PROXY=
# Required only to create an ADMIN account. At least 12 characters in production.
ADMIN_REGISTRATION_CODE=

# Local development without DATABASE_URL uses these:
PGHOST=localhost
PGPORT=5432
PGDATABASE=resourcex
PGUSER=postgres
PGPASSWORD=
