     </div>
 
 
+    <script>
+/* Smart Match is the recipient's search page. This page keeps only the request list. */
+document.addEventListener("DOMContentLoaded", function () {
+    var mine = document.getElementById("myRequestsSection");
+    var main = document.querySelector(".main-content");
+    if (mine && main) {
+        var keep = mine;
+        while (keep.parentElement && keep.parentElement !== main) keep = keep.parentElement;
+        Array.prototype.forEach.call(main.children, function (child) {
+            if (child !== keep && !child.classList.contains("mode-strip")) child.style.display = "none";
+        });
+    }
+    var find = document.getElementById("recipientNavFind");
+    if (find) { var label = find.querySelector("span:not(.ico-slot)"); if (label) label.textContent = "Smart Match"; }
+    document.querySelectorAll(".nav-item").forEach(function (a) {
+        a.classList.toggle("active", a.getAttribute("href") === "recipient_dashboard.html#myRequestsSection" || a.getAttribute("href") === "#myRequestsSection");
+    });
+});
+</script>
